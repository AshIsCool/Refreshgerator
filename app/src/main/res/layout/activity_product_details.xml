<?xml version="1.0" encoding="utf-8"?>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/back_img"
    >

    <!-- Header -->



    <TextView
        android:id="@+id/tvProductHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@drawable/top_header"
        android:fontFamily="sans-serif-condensed-medium"
        android:gravity="center"
        android:padding="10dp"
        android:text="Product Details"
        android:textColor="@color/black"
        android:textSize="20dp"
        android:layout_marginBottom="15dp"
        />

    <!-- Product Name -->
    <EditText
        android:id="@+id/etProductName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Product Name"
        android:inputType="text"
        android:textColor="@color/black"
        android:textSize="15dp"
        android:layout_marginBottom="8dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        />
    <!-- RadioGroup for Storage Type -->
    <!-- RadioGroup for Storage Type -->
    <RadioGroup
        android:id="@+id/rgStorageType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        >
        <RadioButton
            android:id="@+id/rbFromPurchase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="From Purchase"
            android:textSize="15dp"
            />
        <RadioButton
            android:id="@+id/rbFromMade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="From Made"
            android:textSize="15dp"
            />
        <RadioButton
            android:id="@+id/rbGoodUntil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Good Until"
            android:textSize="15dp"
            />
    </RadioGroup>

    <!-- Shelf Life -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        >
        <!-- Input field for Shelf Life -->


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:text="Shelf Life : "
            android:textSize="15dp"
            android:layout_centerVertical="true"
            android:id="@+id/txt_shelf"
            />

        <EditText
            android:id="@+id/etShelfLife"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginRight="15dp"
            android:background="@drawable/edit_background"
            android:hint="Days"
            android:inputType="number"
            android:padding="8dp"
            android:textColor="@color/white"
            android:textColorHint="@color/white"
            android:textSize="15dp" />
    </RelativeLayout>

    <!-- Production Day -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        >

        <TextView
            android:id="@+id/txt_poday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Post Opening Shelf LIfe : "
            android:textColor="@color/black"
            android:layout_centerVertical="true"
            android:textSize="15dp"
            />



        <!-- Input field for Production Day -->
        <EditText
            android:id="@+id/etProductionDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="Days"
            android:inputType="number"
            android:background="@drawable/edit_background"
            android:padding="8dp"
            android:textColorHint="@color/white"
            android:textColor="@color/white"
            android:layout_marginRight="15dp"
            android:textSize="15dp"
            android:layout_alignParentRight="true"
            />


    </RelativeLayout>

    <!-- Production Time -->
<EditText
android:id="@+id/etProductionHour"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:hint=" Hour"
android:inputType="number"
    android:visibility="gone"
    />
<EditText
android:id="@+id/etProductionMinute"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:hint=" Minute"
android:inputType="number"
    android:visibility="gone"
    />

    <!-- Import Date -->
    <!-- RadioGroup for Import Date -->
    <RadioGroup
        android:id="@+id/rgImportDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        >
        <RadioButton
            android:id="@+id/rbOption1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Option 1" />
        <RadioButton
            android:id="@+id/rbOption2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Option 2" />
        <RadioButton
            android:id="@+id/rbOption3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Option 3" />
    </RadioGroup>

    <!-- Notes -->
<EditText
android:id="@+id/etNotes"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:hint="Notes"
android:inputType="text"
    android:layout_marginTop="10dp"
    android:layout_marginLeft="15dp"
    android:layout_marginRight="15dp"
    />

    <!-- Buttons -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:gravity="center"
android:paddingTop="16dp">

<Button
    android:id="@+id/btnUpdateProduct"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Update"
    android:backgroundTint="@color/green"
    android:textColor="@color/white"
    android:textAllCaps="false"
    />

<Button
    android:id="@+id/btnDeleteProduct"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Delete"
    android:backgroundTint="#EA3131"
    android:textColor="@color/white"
    android:textAllCaps="false"
    android:layout_marginStart="16dp"
    />
</LinearLayout>

    </LinearLayout>