<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment1"
    android:background="#00ffffff"
    >


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        >


    <TextView
        android:id="@+id/welcome_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WELCOME TO \nREFRESHGERATOR"
        android:gravity="center"
        android:layout_gravity="top"
        android:layout_marginTop="15dp"
        android:textSize="32dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        />


    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/welcome_img"
        android:scaleType="centerCrop"
        android:layout_above="@id/rel1"
        android:layout_below="@+id/welcome_text"
        />


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/rel1"
            android:layout_alignParentBottom="true"

            >

            <Button
                android:id="@+id/nxt_screen_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Go to the next screen"
                android:textAllCaps="false"
                android:background="@drawable/btn_shape_1"
                android:backgroundTint="#089A54"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="10dp"
                android:textColor="@color/white"
                />

            <Button
                android:id="@+id/close_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Close intro"
                android:textAllCaps="false"
                android:background="@drawable/btn_shape_1"
                android:backgroundTint="#34A1A1A1"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="20dp"
                android:layout_below="@id/nxt_screen_btn"
                android:layout_centerHorizontal="true"
                android:textColor="@color/white"
                android:paddingLeft="25dp"
                android:paddingRight="25dp"
                />


        </RelativeLayout>


    </RelativeLayout>

</FrameLayout>